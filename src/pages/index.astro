---
import Base from '../layouts/Base.astro';
---
<Base>
  <section class="hero">
    <div class="wrap grid">
      <div>
        <h1 class="chrome">Tornado Spinner</h1>
        <p class="kick">The best arcade spinner ever made</p>
        <p class="lede">The world's first ultra-smooth gaming spinner, custom made for retro gaming.
          An extremely smooth, effortless spin that is perfect for emulation and PC gaming — and the one
          must-have part for any serious custom arcade or control panel.</p>
        <div class="cta-row" style="margin-top:26px">
          <a class="btn" href="/contact/">Enquire about a spinner</a>
          <a class="btn ghost" href="/gallery/">See it installed</a>
        </div>
      </div>
      <div class="shot"><img src="/img/product.png" alt="The Tornado Spinner — machined spinner assembly with encoder and Energy Cylinder fly-weight" width="552" height="892" /></div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="specs">
        <div><b>PC or JAMMA</b><span>Works with a PC over USB, or with JAMMA boards through our TTL interface.</span></div>
        <div><b>USB 2.0 · 16-bit</b><span>A faster packet rate than USB 1.1 — vital for avoiding slowdown.</span></div>
        <div><b>Energy Cylinder</b><span>A fly-weight that provides inertia, giving very long spin times.</span></div>
        <div><b>Made in the USA</b><span>Designed and manufactured in the United States.</span></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Why it spins better</p>
        <h2 class="chrome">Built by gamers, for gamers</h2>
      </div>
      <div class="feat">
        <div class="card"><span class="n">01</span><h3>The first of its kind</h3>
          <p>The Tornado Spinner was the world's first custom arcade spinner designed for use with PCs and
            emulators — not a repurposed part, but a spinner built for the job from the start.</p></div>
        <div class="card"><span class="n">02</span><h3>Meticulously designed</h3>
          <p>Every component is designed to strict guidelines by people who play these games. Arcade
            Inventors is a leading arcade design and manufacturing company.</p></div>
        <div class="card"><span class="n">03</span><h3>Not only for gaming</h3>
          <p>The precision that makes it good for Tempest and Arkanoid also suits CNC interfacing and other
            rotary control applications.</p></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What you get</p>
        <h2 class="chrome">One spinner, your choice of finish</h2>
        <p class="lede">The assembly, the encoder and the cable, with a machined aluminium knob in the
          finish you choose.</p>
      </div>
      <img src="/img/spinner-colours.png" alt="The Tornado Spinner assembly with its cable, and knobs in red, blue, purple, silver, black and burgundy"
           width="1204" height="658" style="width:100%;max-width:880px;margin:0 auto;
           filter:drop-shadow(0 20px 44px rgba(0,0,0,.7)) drop-shadow(0 0 40px rgba(41,182,232,.16))" />
    </div>
  </section>

  <section style="background:linear-gradient(180deg,#070c12,#04070b)">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">From the people who own one</p>
        <h2 class="chrome">What owners say</h2></div>
      <div class="quotes">
        <div class="quote"><p>"I love it. The quality is first rate, it looks amazing, and it's a huge hit
          with my family and friends."</p><cite>Kevin C. · Livingston, NJ</cite></div>
        <div class="quote"><p>"It is rumoured the world record for a continuous spin — over five minutes —
          is held by the Tornado Spinner."</p><cite>Arcade Inventors</cite></div>
        <div class="quote"><p>"If you are a serious classic game player, the Tornado Spinner is the one must
          item for any custom arcade or control panel."</p><cite>Arcade Inventors</cite></div>
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="notice"><b>Ordering</b>
        Our online store is being rebuilt. To order a Tornado Spinner, or to ask about quantities and OEM
        supply, <a href="/contact/">send us a message</a> or call <a href="tel:+18007898424">800-789-8424</a>.
      </div>
    </div>
  </section>
</Base>
