---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Tornado Spinner"
      description="That page is not here.">
  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">404</p>
        <h2 class="chrome">That page isn't here</h2>
        <p class="lede">
          The link may be old or mistyped. Here is where everything lives now.
        </p>
      </div>
      <div class="cta-row">
        <a class="btn" href="/">Home</a>
        <a class="btn ghost" href="/support/">Support</a>
        <a class="btn ghost" href="/gallery/">Gallery</a>
        <a class="btn ghost" href="/contact/">Contact</a>
      </div>
    </div>
  </section>
</Base>
